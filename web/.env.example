# Stytch PUBLIC token (safe to ship in frontend) — from Stytch dashboard → API Keys.
# This is NOT the secret; it's the public_token used by the browser SDK.
VITE_STYTCH_PUBLIC_TOKEN=public-token-test-xxxxxxxx
# The project's own Stytch domain: the same value as STYTCH_AUTHORIZATION_SERVER in the
# backend .env. Required for Claude: the browser SDK must call this domain so the
# issuer returned after consent matches the published OAuth metadata.
VITE_STYTCH_BASE_URL=https://your-project.customers.stytch.dev
